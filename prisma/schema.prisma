generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum InvoiceKind {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  CREDIT
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum TaxType {
  INTRA_STATE
  INTER_STATE
}

model Company {
  id            String   @id @default(cuid())
  name          String
  gstin         String?
  pan           String?
  address       String?
  city          String?
  state         String?
  stateCode     String?
  pincode       String?
  phone         String?
  email         String?
  invoicePrefix String   @default("INV")
  financialYear String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  invoices     Invoice[] @relation("CreatedInvoices")
  payments     Payment[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Item {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id])
  unit         String          @default("Nos")
  hsnCode      String?
  gstRate      Decimal         @default(18) @db.Decimal(5, 2)
  purchaseRate Decimal         @default(0) @db.Decimal(12, 2)
  sellingRate  Decimal         @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal         @default(0) @db.Decimal(12, 3)
  currentStock Decimal         @default(0) @db.Decimal(12, 3)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lines        InvoiceLine[]
  movements    StockMovement[]
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  gstin       String?
  address     String?
  city        String?
  state       String?
  stateCode   String?
  pincode     String?
  creditLimit Decimal   @default(0) @db.Decimal(12, 2)
  active      Boolean   @default(true)
  invoices    Invoice[]
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  gstin     String?
  address   String?
  city      String?
  state     String?
  stateCode String?
  pincode   String?
  active    Boolean   @default(true)
  invoices  Invoice[]
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  kind          InvoiceKind
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  taxType       TaxType       @default(INTRA_STATE)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  cgst          Decimal       @default(0) @db.Decimal(14, 2)
  sgst          Decimal       @default(0) @db.Decimal(14, 2)
  igst          Decimal       @default(0) @db.Decimal(14, 2)
  freight       Decimal       @default(0) @db.Decimal(14, 2)
  roundOff      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  notes         String?
  
  // e-Invoice Fields
  eInvoiceIrn     String?
  eInvoiceAckNo   String?
  eInvoiceAckDate DateTime?

  // 🚚 புதுப்பிக்கப்பட்ட E-Way Bill Fields
  eWayBillNo      String?
  eWayBillDate    DateTime?
  eWayBillValidTo DateTime?
  transMode       String?   // 1: Road, 2: Rail, 3: Air, 4: Ship
  transporterId   String?   // Transporter GSTIN
  transporterName String?
  vehicleNo       String?

  createdById String
  createdBy   User            @relation("CreatedInvoices", fields: [createdById], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([kind, status, issueDate])
}

model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  description   String?
  quantity      Decimal  @db.Decimal(12, 3)
  rate          Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  gstRate       Decimal  @db.Decimal(5, 2)
  taxableAmount Decimal  @db.Decimal(14, 2)
  taxAmount     Decimal  @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  vehicleNo     String?
  transporterId String?
}

model Payment {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(14, 2)
  mode         PaymentMode
  reference    String?
  paidAt       DateTime    @default(now())
  receivedById String
  receivedBy   User        @relation(fields: [receivedById], references: [id])
}

model StockMovement {
  id           String       @id @default(cuid())
  itemId       String
  item         Item         @relation(fields: [itemId], references: [id])
  invoiceId    String?
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  type         MovementType
  quantity     Decimal      @db.Decimal(12, 3)
  balanceAfter Decimal      @db.Decimal(12, 3)
  note         String?
  createdAt    DateTime     @default(now())

  @@index([itemId, createdAt])
}